<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Veld</RootNamespace>
    <AssemblyName>Veld</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- the Godot SDK globs every .cs under the project folder; the test project is its own assembly -->
    <Compile Remove="tests/**" />
    <Compile Remove="sim/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="sim/Veld.Sim/Veld.Sim.csproj" />
  </ItemGroup>
</Project>
